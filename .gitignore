# ===== 虚拟环境 =====
.venv/
venv/
env/

# ===== 环境变量与密钥 =====
# 通配兜底：.env.local / .env.dev / .env.bak 等一律不入库，仅放行模板
.env*
!.env.example
*.pem

# ===== Python 缓存与构建产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ===== 运行时数据（不入版本库，只保留 .gitkeep 占位）=====
# logs：PersistentMemory 的 memory.json 等
logs/**
!logs/**/.gitkeep
!logs/.gitkeep

# workspace：file_tool 的读写沙箱
workspace/**
!workspace/**/.gitkeep
!workspace/.gitkeep

# generated：autogen 模式生成的代码
generated/**
!generated/**/.gitkeep
!generated/.gitkeep

*.log

# ===== IDE / 系统 =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
