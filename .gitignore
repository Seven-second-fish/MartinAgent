# ===== 虚拟环境 =====
agent-env/
.venv/
venv/
env/

# ===== 环境变量与密钥 =====
.env
.env.local
*.pem

# ===== Python 缓存与构建产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== 运行时数据（不入版本库，只保留 .gitkeep 占位）=====
# logs：PersistentMemory 的 memory.json 等
my-agent/logs/**
!my-agent/logs/**/.gitkeep
!my-agent/logs/.gitkeep

# workspace：file_tool 的读写沙箱
my-agent/workspace/**
!my-agent/workspace/**/.gitkeep
!my-agent/workspace/.gitkeep

# generated：autogen 模式生成的代码
my-agent/generated/**
!my-agent/generated/**/.gitkeep
!my-agent/generated/.gitkeep

# 兜底：误在仓库根目录启动时，不再把 logs/ 提交上去
/logs/
*.log

# ===== IDE / 系统 =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
