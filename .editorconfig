# ===== 编辑器统一配置（跨 IDE 保持一致）=====
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown 行尾两个空格是「硬换行」语法，不能自动裁剪
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
