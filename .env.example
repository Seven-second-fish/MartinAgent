# 环境变量模板：复制为 .env 后按需修改（在仓库根目录执行）
#   cp .env.example .env          # Linux / macOS
#   copy .env.example .env        # Windows cmd
# 注意：.env 已在 .gitignore 中（.env* 通配），不要把真实密钥提交进 Git。
# 下方 5 个变量与实际代码读取的一一对应，本文件是环境变量的权威清单。

# ---------- 必填：LLM 接入（三选一，取消对应注释即可）----------

# OpenAI 官方
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# DeepSeek（国内常用，默认启用）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 智谱 GLM
# OPENAI_API_KEY=xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_NAME=glm-4-flash

# ---------- 可选：工具相关（不填也能启动，只有对应工具会报错/降级）----------

# 博查网页搜索 API Key（仅 websearch_tool 需要；不填则调用该工具时提示缺少 Key）
WEB_SEARCH_API=your-bocha-api-key

# 天气默认城市（仅 get_weather 需要；问「今天天气」且未指定城市时使用；
# 注释掉本行则按 IP 粗略定位）
DEFAULT_CITY=上海
